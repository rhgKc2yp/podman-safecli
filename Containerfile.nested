# SPDX-License-Identifier: MIT
# Nested namespace-based sandbox profile. No privileged mode or host sockets.
# Actual nested sandbox support depends on host kernel/LSM configuration.
FROM docker.io/library/fedora:latest

# Refresh the current stable Fedora repositories and upgrade ALL installed
# RPMs (including published security fixes) on uncached rebuilds.
# Fail the build if the update step cannot complete.
RUN dnf -y upgrade --refresh \
    && dnf -y --setopt=install_weak_deps=False install \
        ca-certificates \
        curl \
        bubblewrap \
        util-linux \
    && dnf clean all \
    && rm -rf /var/cache/dnf \
    && mkdir -p /work
WORKDIR /work
LABEL org.opencontainers.image.title="safecli-nested" \
      org.opencontainers.image.description="Bubblewrap tools for the rootless Podman nested profile"
