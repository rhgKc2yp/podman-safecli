# SPDX-License-Identifier: MIT
# USB profile: userspace USB inspection/tools only. Device exposure is chosen
# explicitly at runtime with USB_DEVICE, never baked into the image.
FROM docker.io/library/fedora:latest

# Refresh the current stable Fedora repositories and upgrade ALL installed
# RPMs (including published security fixes) on uncached rebuilds.
# Fail the build if the update step cannot complete.
RUN dnf -y upgrade --refresh \
    && dnf -y --setopt=install_weak_deps=False install \
        ca-certificates \
        curl \
        usbutils \
        libusb1 \
    && dnf clean all \
    && rm -rf /var/cache/dnf \
    && mkdir -p /work
WORKDIR /work
LABEL org.opencontainers.image.title="safecli-usb" \
      org.opencontainers.image.description="Userspace USB tools for the rootless Podman USB profile"
