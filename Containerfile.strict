# SPDX-License-Identifier: MIT
# General-purpose CLI toolchain for the strict profile.
# Runtime isolation is enforced by safecli.sh, not by this Containerfile.
FROM docker.io/library/fedora:latest

COPY scripts/install-cli-toolchain.sh /tmp/install-cli-toolchain.sh
RUN bash /tmp/install-cli-toolchain.sh \
    && rm -f /tmp/install-cli-toolchain.sh \
    && mkdir -p /work
ENV npm_config_prefix=/work/.local \
    PATH="${PATH}:/work/.local/bin:/work/.cargo/bin:/work/go/bin"
WORKDIR /work
LABEL org.opencontainers.image.title="safecli-strict" \
      org.opencontainers.image.description="CLI toolchains for the rootless Podman strict profile"
